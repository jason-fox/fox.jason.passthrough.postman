              <fo:inline color="slategray" font-family="MONOSPACE" font-weight="bold">,</fo:inline>
              <fo:inline color="#900050" font-family="MONOSPACE" font-weight="bold">"value"</fo:inline>
              <fo:inline color="SIENNA" font-family="MONOSPACE" font-weight="bold">:</fo:inline>
              <fo:inline color="slategray" font-family="MONOSPACE" font-weight="bold">{</fo:inline>
